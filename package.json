{
  "name": "cairntrace",
  "version": "2.1.0",
  "description": "Behavioral browser-spec layer for agent-in-session use",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cairn": "./bin/cairn"
  },
  "files": [
    "bin",
    "src",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src bin",
    "format:check": "oxfmt --check src bin",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "audit:production": "bun audit --production",
    "verify": "bun run audit:production && bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run test",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/analytics": "^2.0.1",
    "commander": "^12.1.0",
    "execa": "^9.6.1",
    "playwright": "^1.61.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "2.1.9",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.4.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "hono": "4.12.31",
    "postcss": "8.5.23"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
